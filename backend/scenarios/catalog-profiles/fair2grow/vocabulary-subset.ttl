# Controlled-vocabulary concepts used by the DigiLab TK: FAIR2Grow scenario's catalog records.
# Generated by scripts/vocabulary-subset.py; regenerate rather than edit.
#
# Sources: mobilityDCAT-AP controlled vocabularies (https://w3id.org/mobilitydcat-ap/, CC BY 4.0)
# and EU Vocabularies authority tables (http://publications.europa.eu/resource/authority/,
# (c) European Union, reuse under CC BY 4.0). The rdf:type of a profile's range class is added here.

@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://publications.europa.eu/resource/authority/country/NLD> a <http://publications.europa.eu/ontology/euvoc#Country>,
        dct:Location,
        skos:Concept ;
    skos:inScheme <http://publications.europa.eu/resource/authority/country> ;
    skos:prefLabel "Netherlands"@en .

<http://publications.europa.eu/resource/authority/data-theme/AGRI> a <http://publications.europa.eu/ontology/euvoc#DataTheme>,
        skos:Concept ;
    skos:inScheme <http://publications.europa.eu/resource/authority/data-theme> ;
    skos:prefLabel "Agriculture, fisheries, forestry and food"@en .

<http://publications.europa.eu/resource/authority/file-type/JSON> a <http://publications.europa.eu/ontology/euvoc#FileType>,
        dct:MediaTypeOrExtent,
        skos:Concept ;
    skos:inScheme <http://publications.europa.eu/resource/authority/file-type> ;
    skos:prefLabel "JSON"@en .

<http://publications.europa.eu/resource/authority/file-type/ZIP> a <http://publications.europa.eu/ontology/euvoc#FileType>,
        dct:MediaTypeOrExtent,
        skos:Concept ;
    skos:inScheme <http://publications.europa.eu/resource/authority/file-type> ;
    skos:prefLabel "ZIP"@en .

<http://publications.europa.eu/resource/authority/frequency/IRREG> a <http://publications.europa.eu/ontology/euvoc#Frequency>,
        dct:Frequency,
        skos:Concept ;
    skos:inScheme <http://publications.europa.eu/resource/authority/frequency> ;
    skos:prefLabel "irregular"@en .

<http://publications.europa.eu/resource/authority/frequency/NEVER> a <http://publications.europa.eu/ontology/euvoc#Frequency>,
        dct:Frequency,
        skos:Concept ;
    skos:inScheme <http://publications.europa.eu/resource/authority/frequency> ;
    skos:prefLabel "never"@en .

<http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> a <http://publications.europa.eu/ontology/euvoc#Licence>,
        dct:LicenseDocument,
        skos:Concept ;
    skos:inScheme <http://publications.europa.eu/resource/authority/licence> ;
    skos:prefLabel "Creative Commons Attribution 4.0 International"@en .

<http://publications.europa.eu/resource/authority/country> a skos:ConceptScheme ;
    dct:title "Countries and territories"@en .

<http://publications.europa.eu/resource/authority/data-theme> a skos:ConceptScheme ;
    dct:title "Data theme"@en .

<http://publications.europa.eu/resource/authority/licence> a skos:ConceptScheme ;
    dct:title "Licence"@en .

<http://publications.europa.eu/resource/authority/file-type> a skos:ConceptScheme ;
    dct:title "File type"@en .

<http://publications.europa.eu/resource/authority/frequency> a skos:ConceptScheme ;
    dct:title "Frequency"@en .

