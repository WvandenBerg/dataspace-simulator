# Lanelet2 and NDS.Live are in the hub but nobody in this data space publishes
# in them. Searching for road network data with alignments on still returns one
# dataset, which is the honest answer: the registry knows a route exists, the
# data space has nothing at the other end of it.

<urn:vocabhub:profile:lanelet2-1.0>
    a adms:Asset, dcterms:Standard, prof:Profile, dcat:Dataset ;
    adms:assetType <http://purl.org/adms/assettype/Ontology> ;
    dcterms:title "Lanelet2 1.0"@en ;
    dcterms:description "OpenStreetMap-derived HD map format built on lanelets and regulatory elements."@en ;
    dcterms:publisher <urn:vocabhub:agent:kit> ;
    owl:versionInfo "1.0" ;
    prof:hasResource _:r-lanelet2-spec ;
    dcat:distribution _:r-lanelet2-spec .

_:r-lanelet2-spec
    a adms:AssetDistribution, dcat:Distribution, prof:ResourceDescriptor ;
    prof:hasRole role:specification ;
    prof:hasArtifact <https://github.com/fzi-forschungszentrum-informatik/Lanelet2> ;
    dcat:accessURL <https://github.com/fzi-forschungszentrum-informatik/Lanelet2> ;
    dcterms:format "text/html" .


<urn:vocabhub:profile:nds-live-2.5>
    a adms:Asset, dcterms:Standard, prof:Profile, dcat:Dataset ;
    adms:assetType <http://purl.org/adms/assettype/Ontology> ;
    dcterms:title "NDS.Live 2.5"@en ;
    dcterms:description "Service-oriented navigation data standard for automotive map delivery."@en ;
    dcterms:publisher <urn:vocabhub:agent:nds> ;
    owl:versionInfo "2.5" ;
    prof:hasResource _:r-ndslive-spec ;
    dcat:distribution _:r-ndslive-spec .

_:r-ndslive-spec
    a adms:AssetDistribution, dcat:Distribution, prof:ResourceDescriptor ;
    prof:hasRole role:specification ;
    prof:hasArtifact <https://nds-association.org/> ;
    dcat:accessURL <https://nds-association.org/> ;
    dcterms:format "text/html" .


#################################################################
#  Alignments — directed, single hop, coverage attached
#################################################################

<urn:vocabhub:alignment:lanelet2-to-opendrive>
    a pmap:ProfileAlignment, prof:Profile, adms:Asset ;
    adms:assetType <http://purl.org/adms/assettype/Mapping> ;
    dcterms:title "Lanelet2 1.0 to ASAM OpenDRIVE 1.7"@en ;
    dcterms:description "Lanelets and regulatory elements to lanes, junctions and signals. Elevation and lane-marking detail are lost."@en ;
    dcterms:publisher <urn:vocabhub:agent:fuse4ccam> ;
    pmap:sourceProfile <urn:vocabhub:profile:lanelet2-1.0> ;
    pmap:targetProfile <urn:vocabhub:profile:asam-opendrive-1.7> ;
    dqv:hasQualityMeasurement [
        a dqv:QualityMeasurement ;
        dqv:isMeasurementOf vhx:profileCoverage ;
        dqv:value "0.72"^^xsd:decimal
    ] ;
    prof:hasResource _:r-align-lanelet2 ;
    dcat:distribution _:r-align-lanelet2 .

_:r-align-lanelet2
    a adms:AssetDistribution, dcat:Distribution, prof:ResourceDescriptor ;
    prof:hasRole role:mapping ;
    prof:hasArtifact <urn:vocabhub:artifact:lanelet2-to-opendrive.rml.ttl> ;
    dcterms:format "text/turtle" .


<urn:vocabhub:alignment:nds-live-to-opendrive>
    a pmap:ProfileAlignment, prof:Profile, adms:Asset ;
    adms:assetType <http://purl.org/adms/assettype/Mapping> ;
    dcterms:title "NDS.Live 2.5 to ASAM OpenDRIVE 1.7"@en ;
    dcterms:description "Navigation road geometry to a logical road network. Routing attributes and service layers have no target."@en ;
    dcterms:publisher <urn:vocabhub:agent:fuse4ccam> ;
    pmap:sourceProfile <urn:vocabhub:profile:nds-live-2.5> ;
    pmap:targetProfile <urn:vocabhub:profile:asam-opendrive-1.7> ;
    dqv:hasQualityMeasurement [
        a dqv:QualityMeasurement ;
        dqv:isMeasurementOf vhx:profileCoverage ;
        dqv:value "0.61"^^xsd:decimal
    ] ;
    prof:hasResource _:r-align-ndslive ;
    dcat:distribution _:r-align-ndslive .

_:r-align-ndslive
    a adms:AssetDistribution, dcat:Distribution, prof:ResourceDescriptor ;
    prof:hasRole role:mapping ;
    prof:hasArtifact <urn:vocabhub:artifact:nds-live-to-opendrive.rml.ttl> ;
    dcterms:format "text/turtle" .


<urn:vocabhub:alignment:nuscenes-to-openlabel>
    a pmap:ProfileAlignment, prof:Profile, adms:Asset ;
    adms:assetType <http://purl.org/adms/assettype/Mapping> ;
    dcterms:title "nuScenes 1.0 to ASAM OpenLABEL 1.0"@en ;
    dcterms:description "Scenes, samples and annotated instances to OpenLABEL frames and objects. Close fit: both describe annotated sensor streams."@en ;
    dcterms:publisher <urn:vocabhub:agent:fuse4ccam> ;
    pmap:sourceProfile <urn:vocabhub:profile:nuscenes-1.0> ;
    pmap:targetProfile <urn:vocabhub:profile:asam-openlabel-1.0> ;
    dqv:hasQualityMeasurement [
        a dqv:QualityMeasurement ;
        dqv:isMeasurementOf vhx:profileCoverage ;
        dqv:value "0.81"^^xsd:decimal
    ] ;
    prof:hasResource _:r-align-nuscenes ;
    dcat:distribution _:r-align-nuscenes .

_:r-align-nuscenes
    a adms:AssetDistribution, dcat:Distribution, prof:ResourceDescriptor ;
    prof:hasRole role:mapping ;
    prof:hasArtifact <urn:vocabhub:artifact:nuscenes-to-openlabel.rml.ttl> ;
    dcterms:format "text/turtle" .


<urn:vocabhub:alignment:kitti-to-openlabel>
    a pmap:ProfileAlignment, prof:Profile, adms:Asset ;
    adms:assetType <http://purl.org/adms/assettype/Mapping> ;
    dcterms:title "KITTI object format 1.0 to ASAM OpenLABEL 1.0"@en ;
    dcterms:description "Per-frame text labels to OpenLABEL objects. KITTI carries no scenario, sensor calibration or tracking identity, so much of the target is unreachable."@en ;
