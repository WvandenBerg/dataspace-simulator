# Vocabulary Hub contents for the fuse4ccam scenario.
#
# Written in the shape that Semantic Treehouse's catalogue export v2 emits
# (GET /api/environment/export?type=v2), so the simulator consumes what STH
# actually produces rather than a model invented here. Profiles carry
# prof:hasResource descriptors; alignments are pmap:ProfileAlignment with a
# directed source and target.
#
# Two deliberate departures, both arguments the demo is making:
#
#   1. Coverage on an alignment. STH's export has no dqv: terms at all, so the
#      metric below lives in this file's own namespace and is labelled as a
#      proposal wherever it reaches the screen. See epic 50.
#   2. Every data standard here is external (ASAM, ISO, CEN, Waymo). STH turns
#      only a published MessageModelVersion into a prof:Profile, so none of
#      them could be represented in a real export today.
#
# Alignment coverage figures are illustrative. Nobody has measured these.

@prefix adms:    <http://www.w3.org/ns/adms#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dqv:     <http://www.w3.org/ns/dqv#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix pmap:    <https://w3id.org/pmap#> .
@prefix prof:    <http://www.w3.org/ns/dx/prof/> .
@prefix role:    <http://www.w3.org/ns/dx/prof/role/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix vhx:     <urn:vocabhub:ext:> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .


#################################################################
#  Catalogue
#################################################################

<urn:vocabhub:catalog:fuse4ccam>
    a dcat:Catalog, adms:AssetRepository ;
    dcterms:title "FUSE4CCAM Vocabulary Hub"@en ;
    dcterms:description "Schema registry for the FUSE4CCAM test data space. Holds the profile that governs catalogue records and the data standards their distributions are written in."@en ;
    dcterms:publisher <urn:vocabhub:agent:fuse4ccam> ;
    dcat:landingPage <https://www.semantic-treehouse.nl/> ;
    dcat:resource
        <urn:vocabhub:profile:mobilitydcat-ap-1.1.0> ,
        <urn:vocabhub:profile:asam-opendrive-1.7> ,
        <urn:vocabhub:profile:asam-openlabel-1.0> ,
        <urn:vocabhub:profile:asam-openscenario-xml-1.2> ,
        <urn:vocabhub:profile:asam-openscenario-dsl-2.0> ,
        <urn:vocabhub:profile:nuscenes-1.0> ,
        <urn:vocabhub:profile:kitti-1.0> ,
        <urn:vocabhub:profile:waymo-open-motion-1.2> ,
        <urn:vocabhub:profile:iso-34503-2023> ,
        <urn:vocabhub:profile:datex-ii-3.3> ,
        <urn:vocabhub:profile:sensoris-1.2> ,
        <urn:vocabhub:profile:lanelet2-1.0> ,
        <urn:vocabhub:profile:nds-live-2.5> ,
        <urn:vocabhub:alignment:lanelet2-to-opendrive> ,
        <urn:vocabhub:alignment:nds-live-to-opendrive> ,
        <urn:vocabhub:alignment:nuscenes-to-openlabel> ,
        <urn:vocabhub:alignment:kitti-to-openlabel> ,
        <urn:vocabhub:alignment:openscenario-dsl-to-xml> ,
        <urn:vocabhub:alignment:waymo-to-nuscenes> .


#################################################################
#  Coverage metric — proposed extension, see the header
#################################################################

vhx:profileCoverage
    a dqv:Metric ;
    skos:prefLabel "Profile coverage"@en ;
    skos:definition "Share of the target profile's properties an alignment can populate from the source profile."@en ;
    dqv:inDimension vhx:completeness ;
    dqv:expectedDataType xsd:decimal .

vhx:completeness
    a dqv:Dimension ;
    skos:prefLabel "Completeness"@en .


#################################################################
#  Publishers
#################################################################

<urn:vocabhub:agent:fuse4ccam>    a foaf:Agent ; foaf:name "FUSE4CCAM consortium" .
<urn:vocabhub:agent:mdcatap>      a foaf:Agent ; foaf:name "mobilityDCAT-AP working group" .
<urn:vocabhub:agent:asam>         a foaf:Agent ; foaf:name "ASAM e.V." .
<urn:vocabhub:agent:iso>          a foaf:Agent ; foaf:name "International Organization for Standardization" .
<urn:vocabhub:agent:motional>     a foaf:Agent ; foaf:name "Motional" .
<urn:vocabhub:agent:kit>          a foaf:Agent ; foaf:name "Karlsruhe Institute of Technology" .
<urn:vocabhub:agent:waymo>        a foaf:Agent ; foaf:name "Waymo LLC" .
<urn:vocabhub:agent:datex>        a foaf:Agent ; foaf:name "DATEX II / CEN TC 278" .
<urn:vocabhub:agent:ertico>       a foaf:Agent ; foaf:name "ERTICO - ITS Europe" .
<urn:vocabhub:agent:nds>          a foaf:Agent ; foaf:name "NDS Association" .


#################################################################
#  Axis A — the profile that governs the catalogue records
#
#  In no alignment. It is the language every record is written in,
#  not one of the formats a payload might be in.
#################################################################

<urn:vocabhub:profile:mobilitydcat-ap-1.1.0>
    a adms:Asset, dcterms:Standard, prof:Profile, dcat:Dataset ;
    adms:assetType <http://purl.org/adms/assettype/Ontology> ;
    dcterms:title "mobilityDCAT-AP 1.1.0"@en ;
    dcterms:description "Application profile for mobility data portals. Stands in for CCAM-DCAT-AP, which task T1.2 has not yet produced."@en ;
    dcterms:publisher <urn:vocabhub:agent:mdcatap> ;
    owl:versionInfo "1.1.0" ;
    prof:isProfileOf <https://semiceu.github.io/DCAT-AP/releases/2.0.1/> ;
    prof:hasResource _:r-mdcatap-spec, _:r-mdcatap-vocab, _:r-mdcatap-shapes ;
    dcat:distribution _:r-mdcatap-spec, _:r-mdcatap-vocab, _:r-mdcatap-shapes .

_:r-mdcatap-spec
    a adms:AssetDistribution, dcat:Distribution, prof:ResourceDescriptor ;
    prof:hasRole role:specification ;
    prof:hasArtifact <https://w3id.org/mobilitydcat-ap/releases/1.1.0/> ;
    dcat:accessURL <https://w3id.org/mobilitydcat-ap/releases/1.1.0/> ;
    dcterms:format "text/html" .

_:r-mdcatap-vocab
    a adms:AssetDistribution, dcat:Distribution, prof:ResourceDescriptor ;
    prof:hasRole role:vocabulary ;
    prof:hasArtifact <https://w3id.org/mobilitydcat-ap/releases/1.1.0/mobilitydcat-ap_v1.1.0.ttl> ;
    dcat:accessURL <https://w3id.org/mobilitydcat-ap/releases/1.1.0/mobilitydcat-ap_v1.1.0.ttl> ;
    dcterms:format "text/turtle" .

# The one role:validation artifact in this catalogue, and the join between the
# two workflows: validation resolves the shapes through exactly this path.
_:r-mdcatap-shapes
    a adms:AssetDistribution, dcat:Distribution, prof:ResourceDescriptor ;
    prof:hasRole role:validation ;
    prof:hasArtifact <https://w3id.org/mobilitydcat-ap/releases/1.1.0/shaclShapes/mobilitydcat-ap-shacl.ttl> ;
    dcat:accessURL <https://w3id.org/mobilitydcat-ap/releases/1.1.0/shaclShapes/mobilitydcat-ap-shacl.ttl> ;
    dcterms:conformsTo <https://semiceu.github.io/DCAT-AP/releases/2.0.1/shacl/dcat-ap-SHACL.ttl> ;
    dcterms:format "text/turtle" .


#################################################################
#  Axis B — the data standards the payloads are written in
#
#  These are what mobilitydcatap:schema points at from a distribution,
#  and what the alignments below run between.
#################################################################

