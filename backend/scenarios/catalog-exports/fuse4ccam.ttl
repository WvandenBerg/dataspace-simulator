# The no-chaining control. nuScenes aligns to OpenLABEL, so a naive
# implementation would offer the Waymo dataset to someone searching for
# OpenLABEL. US-6 is single hop: it must not appear, and coverage does not
# compose anyway.

<urn:vocabhub:alignment:waymo-to-nuscenes>
    a pmap:ProfileAlignment, prof:Profile, adms:Asset ;
    adms:assetType <http://purl.org/adms/assettype/Mapping> ;
    dcterms:title "Waymo Open Motion 1.2 to nuScenes 1.0"@en ;
    dcterms:description "Trajectories and map features to scenes and instances. Sensor payloads differ enough that only the motion layer transfers."@en ;
    dcterms:publisher <urn:vocabhub:agent:fuse4ccam> ;
    pmap:sourceProfile <urn:vocabhub:profile:waymo-open-motion-1.2> ;
    pmap:targetProfile <urn:vocabhub:profile:nuscenes-1.0> ;
    dqv:hasQualityMeasurement [
        a dqv:QualityMeasurement ;
