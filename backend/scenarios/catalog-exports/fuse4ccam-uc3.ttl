# Vocabulary Hub contents for the fuse4ccam-uc3 scenario.
#
# Same shape as catalog-exports/fuse4ccam.ttl, which follows Semantic
# Treehouse's catalogue export v2. Holds the data standards the UC3
# distributions conform to, and the C-ITS code lists that SPATEM uses.
# No alignments: the scenario is about finding C-ITS and traffic data,
# not translating between standards.

@prefix adms:    <http://www.w3.org/ns/adms#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix prof:    <http://www.w3.org/ns/dx/prof/> .
@prefix role:    <http://www.w3.org/ns/dx/prof/role/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .


#################################################################
#  Catalogue
#################################################################

<urn:vocabhub:catalog:fuse4ccam-uc3>
    a dcat:Catalog, adms:AssetRepository ;
    dcterms:title "FUSE4CCAM UC3 Vocabulary Hub"@en ;
    dcterms:description "Schema registry for the UC3 traffic management data space. Holds the data standards that the Helmond and Hamburg datasets are written in, and the C-ITS code lists SPATEM uses."@en ;
    dcterms:publisher <urn:vocabhub:agent:fuse4ccam> ;
    dcat:landingPage <https://www.semantic-treehouse.nl/> ;
    dcat:resource
        <http://localhost:4200/id/specification/spatem/2.3.1> ,
        <http://localhost:4200/api/codelist/-/version/CodelistVersion_c907bae5-296c-475f-b6ce-8dc9cad0d58f> ,
        <http://localhost:4200/api/codelist/-/version/CodelistVersion_99007a6b-8a05-4662-b8e1-aa39a680ff25> ,
        <http://localhost:4200/api/codelist/-/version/CodelistVersion_e5ad21df-a39d-48c9-bc34-85918b2c15b9> ,
        <urn:vocabhub:profile:etsi-ts-103-301-2.3.1> ,
        <urn:vocabhub:profile:etsi-en-302-637-2-1.4.1> ,
        <urn:vocabhub:profile:etsi-en-302-637-3-1.3.1> ,
        <urn:vocabhub:profile:etsi-ts-103-324-2.1.1> ,
        <urn:vocabhub:profile:datex-ii-3.3> ,
        <urn:vocabhub:profile:ocit-c> ,
        <urn:vocabhub:profile:ogc-sensorthings-1.1> ,
        <urn:vocabhub:profile:asam-opendrive-1.7> .


#################################################################
#  Publishers
#################################################################

<urn:vocabhub:agent:fuse4ccam>    a foaf:Agent ; foaf:name "FUSE4CCAM consortium" .
<urn:vocabhub:agent:etsi>         a foaf:Agent ; foaf:name "ETSI TC ITS" .
<urn:vocabhub:agent:datex>        a foaf:Agent ; foaf:name "DATEX II / CEN TC 278" .
<urn:vocabhub:agent:ocit>         a foaf:Agent ; foaf:name "OCIT Developer Group" .
<urn:vocabhub:agent:ogc>          a foaf:Agent ; foaf:name "Open Geospatial Consortium" .
<urn:vocabhub:agent:asam>         a foaf:Agent ; foaf:name "ASAM e.V." .


#################################################################
#  C-ITS messages
#################################################################

<urn:vocabhub:profile:etsi-ts-103-301-2.3.1>
    a adms:Asset, dcterms:Standard, prof:Profile, dcat:Dataset ;
    adms:assetType <http://purl.org/adms/assettype/Ontology> ;
    dcterms:title "ETSI TS 103 301 2.3.1 (SPATEM, MAPEM, SREM, SSEM)"@en ;
    dcterms:description "C-ITS infrastructure messages: signal phase and timing, intersection topology, and signal priority requests and responses. Payloads follow ISO TS 19091."@en ;
    dcterms:publisher <urn:vocabhub:agent:etsi> ;
    dcterms:isVersionOf <https://w3id.org/mobilitydcat-ap/mobility-data-standard/c-its> ;
    owl:versionInfo "2.3.1" ;
    prof:hasResource _:r-ts103301-schema ;
    dcat:distribution _:r-ts103301-schema .

_:r-ts103301-schema
    a adms:AssetDistribution, dcat:Distribution, prof:ResourceDescriptor ;
    prof:hasRole role:schema ;
    prof:hasArtifact <https://forge.etsi.org/rep/ITS/asn1/is_ts103301> ;
    dcat:accessURL <https://forge.etsi.org/rep/ITS/asn1/is_ts103301> ;
    dcterms:format "text/html" .


