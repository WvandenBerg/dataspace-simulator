#################################################################
#  SPATEM, from Semantic Treehouse
#
#  Excerpt of a project export from a local STH instance
#  (localhost:4200, 2026-10-09), so these IRIs only resolve there and
#  change when the model is imported again. See STH epic &115.
#  Only prof:isProfileOf is added here; the export does not state it.
#################################################################

@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .

<http://localhost:4200/specification/-/version/MessageModelVersion_5edadcdf-18ca-4723-b28b-edddb099bbc9>
  prof:isProfileOf <urn:vocabhub:profile:etsi-ts-103-301-2.3.1> .

<http://localhost:4200/groups/FUSE4CCAM+consortium+partners>
  foaf:name "FUSE4CCAM consortium partners"@en ;
  a foaf:Agent .

<http://localhost:4200/message-model/MessageModelSpec_75e6976a-5b1d-464e-b404-584e2d62b481>
  dcterms:description """Signal phase and timing of one or more signalised intersections.

Covers the SPAT data frame that ETSI TS 103 301 carries in a SPATEM, as defined in module ETSI-ITS-DSRC

Written for a FUSE4CCAM demo, and regional extensions and SpeedConfidence are left out. Plus the ITS PDU header of the SPATEM is not modelled."""@en ;
  dcterms:title "SPATEM"@en ;
  dcterms:publisher <http://localhost:4200/groups/FUSE4CCAM+consortium+partners> ;
  dcterms:hasVersion <http://localhost:4200/specification/-/version/MessageModelVersion_5edadcdf-18ca-4723-b28b-edddb099bbc9> ;
  dcterms:identifier "http://localhost:4200/message-model/MessageModelSpec_75e6976a-5b1d-464e-b404-584e2d62b481"@en ;
  a foaf:Document, dcat:Dataset ;
  dcat:landingPage <http://localhost:4200/message-model/MessageModelSpec_75e6976a-5b1d-464e-b404-584e2d62b481> .

<http://localhost:4200/specification/-/version/MessageModelVersion_5edadcdf-18ca-4723-b28b-edddb099bbc9>
