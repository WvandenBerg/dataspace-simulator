#################################################################
#  SPATEM and its C-ITS code lists, from Semantic Treehouse
#
#  Excerpt of the export of project "FUSE4CCAM kick-off demo" from a
#  local STH instance (localhost:4200, 2026-11-05), so these IRIs only
#  resolve there. Since STH epic &115 a spec version is named by its
#  slug and version number, so the SPATEM IRIs survive a new import as
#  long as the slug stays; its download URLs still carry database ids.
#  Code list versions are still named by their database id, as
#  CodelistVersion::getUri bypasses the permalink.
#  Left out: the STH environment and project catalogues. Only
#  prof:isProfileOf is added here; the export does not state it.
#################################################################

@prefix sh:  <http://www.w3.org/ns/shacl#> .

<http://localhost:4200/id/specification/spatem/2.3.1>
  prof:isProfileOf <urn:vocabhub:profile:etsi-ts-103-301-2.3.1> .

<http://localhost:4200/id/group/fuse4ccam-consortium-partners>
  foaf:name "FUSE4CCAM consortium partners"@en ;
  a foaf:Agent .

<http://localhost:4200/id/specification/advisoryspeedtype>
  a dcat:Dataset ;
  dcterms:description "What an advised approach speed in a SPATEM is for, such as a green wave or eco-driving."@en ;
  dcterms:title "Advisory speed type (C-ITS)"@en ;
  dcterms:publisher <http://localhost:4200/id/group/fuse4ccam-consortium-partners> ;
  dcterms:hasVersion <http://localhost:4200/api/codelist/-/version/CodelistVersion_c907bae5-296c-475f-b6ce-8dc9cad0d58f> ;
  dcterms:identifier "http://localhost:4200/id/specification/advisoryspeedtype"@en ;
  dcat:landingPage <http://localhost:4200/specification/advisoryspeedtype> .

<http://localhost:4200/api/codelist/-/version/CodelistVersion_c907bae5-296c-475f-b6ce-8dc9cad0d58f>
