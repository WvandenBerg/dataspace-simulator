<http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform>
  a dcat:Dataset ;
  dcterms:description "Logical data model of a cultivation export from the Wageningen University & Research (WUR) Greenhouse Data Platform, as delivered for the FAIR2Grow use case of DigiLab TK. It describes the files of the export: the cultivation configuration (_cultivation.json), the data dictionary (datastreams.csv), the Frictionless Data Package (datapackage.json) and one CSV file per datastream. A cultivation is organised as a tree of components; each component holds datastreams; each datastream is a time series of observations (DateTime, value). The model follows WUR's own terms (bottom-up). It is not aligned to an ontology; that alignment is a separate mapping in Semantic Treehouse."@en ;
  dcterms:title "FAIR2Grow: WUR Greenhouse Data Platform export"@en ;
  dcterms:publisher <http://localhost:4200/id/group/fair2grow-partners> ;
  dcterms:hasVersion <http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.1.0> ;
  dcterms:identifier "http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform"@en ;
  dcat:landingPage <http://localhost:4200/specification/fair2grow-greenhouse-data-platform> .

<http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.1.0>
  a dcat:Dataset, dcterms:Standard, prof:Profile ;
  dcterms:description "Logical data model of a cultivation export from the Wageningen University & Research (WUR) Greenhouse Data Platform, as delivered for the FAIR2Grow use case of DigiLab TK. It describes the files of the export: the cultivation configuration (_cultivation.json), the data dictionary (datastreams.csv), the Frictionless Data Package (datapackage.json) and one CSV file per datastream. A cultivation is organised as a tree of components; each component holds datastreams; each datastream is a time series of observations (DateTime, value). The model follows WUR's own terms (bottom-up). It is not aligned to an ontology; that alignment is a separate mapping in Semantic Treehouse."@en ;
  dcterms:title "FAIR2Grow: WUR Greenhouse Data Platform export v0.1.0"@en ;
  dcat:distribution <http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.1.0/distributions/message-xsd>, <http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.1.0/distributions/message-json-schema-json>, <http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.1.0/distributions/message-json-schema-yaml>, <http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.1.0/distributions/message-oas-json>, <http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.1.0/distributions/message-oas-yaml>, <http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.1.0/distributions/message-rdf-shacl-ttl>, <http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.1.0/distributions/message-spreadsheet>, _:genid2, _:genid3, _:genid4 ;
