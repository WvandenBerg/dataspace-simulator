#################################################################
#  Hand-written, not part of the STH export
#################################################################

@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dqv:  <http://www.w3.org/ns/dqv#> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix role: <http://www.w3.org/ns/dx/prof/role/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vhx:  <urn:vocabhub:ext:> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Coverage, proposed extension (see fuse4ccam.ttl).

vhx:profileCoverage
    a dqv:Metric ;
    skos:prefLabel "Profile coverage"@en ;
    skos:definition "Share of the target profile's properties an alignment can populate from the source profile."@en ;
    dqv:inDimension vhx:completeness ;
    dqv:expectedDataType xsd:decimal .

vhx:completeness
    a dqv:Dimension ;
    skos:prefLabel "Completeness"@en .

# Elements 0.1.0 (from WUR model 0.2.0): 15 of the 18 elements below the root of the derived model are
# mapped. Not populated: samplingInterval, qualityFlag, and dataLocation (a packaging concern).
<http://localhost:4200/id/specification/fair2grow-to-saref4agri-elements/0.1.0>
    dqv:hasQualityMeasurement [
        a dqv:QualityMeasurement ;
        dqv:isMeasurementOf vhx:profileCoverage ;
        dqv:value "0.83"^^xsd:decimal
    ] .

# Elements 0.2.0 (from WUR model 0.3.0): 14 of 18. Also not populated: studiesCrop, since the crop is not in
# WUR's data and 0.3.0 no longer adds it.
<http://localhost:4200/id/specification/fair2grow-to-saref4agri-elements/0.2.0>
    dqv:hasQualityMeasurement [
        a dqv:QualityMeasurement ;
        dqv:isMeasurementOf vhx:profileCoverage ;
        dqv:value "0.78"^^xsd:decimal
    ] .

# 12 of the 122 SAREF4AGRI properties are a target of a FAIR2Grow observed property. Most
# SAREF4AGRI properties are about crops and greenhouse construction, not climate.
<http://localhost:4200/id/specification/fair2grow-to-saref4agri-properties/0.1.0>
    dqv:hasQualityMeasurement [
        a dqv:QualityMeasurement ;
        dqv:isMeasurementOf vhx:profileCoverage ;
        dqv:value "0.10"^^xsd:decimal
    ] .

# The Frictionless binding (MIM level 4) of the WUR logical model: a Data Package descriptor whose
# Table Schemas link every column to an element of the logical model (sth-greenhouse-bundle/fair2grow/
# binding). STH cannot host it, so it is a resource of the WUR profile described here. Its location
# is illustrative: WUR would publish it. Distributions of WUR exports name it in dct:conformsTo.
<https://data.sim.local/wur/schemas/greenhouse-data-platform-export/0.3.0/datapackage.json>
    a dcterms:Standard ;
    dcterms:title "WUR Greenhouse Data Platform export, Frictionless binding 0.3.0"@en ;
    dcterms:description "How a cultivation export is packaged: one CSV file per datastream (DateTime, value), a data dictionary datastreams.csv and a Frictionless Data Package descriptor. Binding of the logical model fair2grow-greenhouse-data-platform 0.3.0."@en ;
    dcterms:conformsTo <https://datapackage.org/standard/data-package/> .

<http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.3.0>
    prof:hasResource [
        a prof:ResourceDescriptor, dcat:Distribution ;
        prof:hasRole role:schema ;
        dcterms:title "Frictionless binding (CSV export)"@en ;
        prof:hasArtifact <https://data.sim.local/wur/schemas/greenhouse-data-platform-export/0.3.0/datapackage.json> ;
        dcat:accessURL <https://data.sim.local/wur/schemas/greenhouse-data-platform-export/0.3.0/datapackage.json> ;
        dcterms:conformsTo <https://datapackage.org/standard/data-package/>
    ] .
