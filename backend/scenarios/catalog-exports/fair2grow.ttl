<http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.3.0>
  a dcat:Dataset, dcterms:Standard, prof:Profile ;
  dcterms:description "Logical data model (MIM level 3) of the cultivation data in the Wageningen University & Research (WUR) Greenhouse Data Platform, as delivered for the FAIR2Grow use case of DigiLab TK. A cultivation (an experiment) has treatments, each applied in a greenhouse compartment; compartments contain installations; datastreams are time series of one property of a compartment, an installation or the outside weather. The model follows WUR's own terms (bottom-up) and is independent of how the data is packaged. The physical model of the export (a Frictionless Data Package with one CSV file per datastream) is a separate binding of this model; see fair2grow/binding in the source repository. Alignment to SAREF4AGRI is a separate mapping in Semantic Treehouse."@en ;
  dcterms:title "FAIR2Grow: WUR Greenhouse Data Platform export v0.3.0"@en ;
  dcat:distribution <http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.3.0/distributions/message-xsd>, <http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.3.0/distributions/message-json-schema-json>, <http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.3.0/distributions/message-json-schema-yaml>, <http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.3.0/distributions/message-oas-json>, <http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.3.0/distributions/message-oas-yaml>, <http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.3.0/distributions/message-rdf-shacl-ttl>, <http://localhost:4200/id/specification/fair2grow-greenhouse-data-platform/0.3.0/distributions/message-spreadsheet>, _:genid8, _:genid9, _:genid10 ;
  dcterms:publisher <http://localhost:4200/id/group/fair2grow-partners> ;
