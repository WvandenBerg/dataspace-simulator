# CCAM-DCAT-AP, illustrative draft for the dataspace simulator.
#
# Not a FUSE4CCAM deliverable and not a proposal. WP1 and WP2 design
# CCAM-DCAT-AP; this file only shows what adding one field on top of
# mobilityDCAT-AP 3.0.0 does to a catalog that already exists. The
# namespace is example.org on purpose.
#
# Upload this file together with the other files in the same folder,
# then set the profile's data standard field to
# "dataset distribution > Conforms to", as the mobilityDCAT-AP 3.0.0
# profile has it.

@prefix ccam: <https://example.org/ccam-dcat-ap#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://example.org/ccam-dcat-ap>
    a owl:Ontology ;
    dct:title "CCAM-DCAT-AP, illustrative draft"@en ;
    rdfs:comment "Adds the SAE J3016 automation level to mobilityDCAT-AP 3.0.0. For simulator demos only."@en .

ccam:automationLevel
    a rdf:Property ;
    rdfs:label "automation level"@en ;
    rdfs:comment "SAE J3016 level of driving automation the data was recorded with or generated for."@en .

ccam:AutomationLevels
    a skos:ConceptScheme ;
    skos:prefLabel "SAE J3016 levels of driving automation"@en .

ccam:level0 a skos:Concept ; skos:inScheme ccam:AutomationLevels ; skos:prefLabel "Level 0: no driving automation"@en .
ccam:level1 a skos:Concept ; skos:inScheme ccam:AutomationLevels ; skos:prefLabel "Level 1: driver assistance"@en .
ccam:level2 a skos:Concept ; skos:inScheme ccam:AutomationLevels ; skos:prefLabel "Level 2: partial driving automation"@en .
ccam:level3 a skos:Concept ; skos:inScheme ccam:AutomationLevels ; skos:prefLabel "Level 3: conditional driving automation"@en .
ccam:level4 a skos:Concept ; skos:inScheme ccam:AutomationLevels ; skos:prefLabel "Level 4: high driving automation"@en .
ccam:level5 a skos:Concept ; skos:inScheme ccam:AutomationLevels ; skos:prefLabel "Level 5: full driving automation"@en .

# Mandatory, so that a catalog which predates the field fails validation.
ccam:DatasetShape
    a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    sh:property [
        sh:path ccam:automationLevel ;
        sh:name "automation level"@en ;
        sh:description "SAE J3016 level of driving automation the data was recorded with or generated for."@en ;
        sh:nodeKind sh:IRI ;
        sh:in ( ccam:level0 ccam:level1 ccam:level2 ccam:level3 ccam:level4 ccam:level5 ) ;
        sh:minCount 1 ;
        sh:message "Automation level is mandatory and must be one of the SAE J3016 levels 0 to 5"@en ;
    ] .
